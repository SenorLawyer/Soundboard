<Window x:Class="Soundboard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Soundboard"
    Title="Soundboard" Icon="Assets/soundboard.ico" Width="750" Height="475" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
    Foreground="{StaticResource Primary}" FontFamily="./Assets/Fonts/#Inter, Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
    AllowDrop="True" PreviewDragOver="DragOverFiles" PreviewDragLeave="DragLeaveFiles" PreviewDrop="DropFiles" PreviewKeyDown="OnKey">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="12" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Border x:Name="Chrome" BorderBrush="#477D7982" BorderThickness="1" CornerRadius="11">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DD121316" Offset="0.24"/><GradientStop Color="#EA1D1D1F" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition/><RowDefinition Height="40"/></Grid.RowDefinitions>
      <Border Grid.RowSpan="3" CornerRadius="10" IsHitTestVisible="False"><Border.Background><RadialGradientBrush Center=".55,.015" GradientOrigin=".55,.015" RadiusX=".55" RadiusY=".34"><GradientStop Color="#21E9E6F2" Offset="0"/><GradientStop Color="#00E9E6F2" Offset="1"/></RadialGradientBrush></Border.Background></Border>
      <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Background="Transparent" MouseLeftButtonDown="DragWindow">
        <Grid Margin="16,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Viewbox Width="21" Height="21" Margin="0,0,13,0"><Path Data="M3,10 L3,14 M7.5,5 L7.5,19 M12,2 L12,22 M16.5,6 L16.5,18 M21,10 L21,14" Stroke="#A4A0AC" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
          <Grid Grid.Column="1"><TextBlock x:Name="Placeholder" Text="Search sounds..." Foreground="{StaticResource Muted}" FontSize="18" IsHitTestVisible="False"/><TextBox x:Name="Search" FontSize="18" AutomationProperties.Name="Search sounds" TextChanged="SearchChanged"/></Grid>
          <Button Grid.Column="2" Click="ImportClick" ToolTip="Import sounds (Ctrl+O)" AutomationProperties.Name="Import sounds"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="Import"/></StackPanel></Button>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <ListBox x:Name="Sounds" Padding="0" Margin="7,1,7,5" SelectionChanged="SelectionChanged" MouseDoubleClick="SoundDoubleClick" PreviewMouseRightButtonUp="RowMenu" AutomationProperties.Name="Sound library">
          <ListBox.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><StackPanel>
              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Secondary}" Margin="8,15,0,8"/>
              <ItemsPresenter/>
            </StackPanel></ControlTemplate></Setter.Value></Setter>
          </Style></GroupStyle.ContainerStyle></GroupStyle></ListBox.GroupStyle>
          <ListBox.ItemTemplate><DataTemplate DataType="{x:Type local:Sound}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
              <local:SoundGlyph Variant="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0"/>
              <DockPanel Grid.Column="1" LastChildFill="False"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Format}" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource Muted}"/></DockPanel>
              <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0,6,0"/>
              <TextBlock Grid.Column="3" Text="{Binding DurationLabel}" HorizontalAlignment="Right" Foreground="{StaticResource Secondary}" Typography.NumeralAlignment="Tabular"/>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
        </ListBox>
        <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" Foreground="{StaticResource Secondary}" Margin="0,7,0,12"/><Button Content="Import sounds…" Click="ImportClick" HorizontalAlignment="Center"/></StackPanel>
      </Grid>
      <Border Grid.Row="2" Background="#15000000" CornerRadius="0,0,10,10" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
        <Grid Margin="8,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="RoutingButton" HorizontalAlignment="Left" MaxWidth="340" Click="RoutingClick" AutomationProperties.Name="Audio routing" ToolTip="Audio routing"><StackPanel Orientation="Horizontal">
            <Image Source="Assets/soundboard.ico" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Soundboard" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="›" Margin="8,0" Foreground="{StaticResource Muted}"/>
            <Ellipse x:Name="RouteDot" Width="6" Height="6" VerticalAlignment="Center" Fill="#A69A82" Margin="0,1,6,0"/><TextBlock x:Name="RouteStatus" Text="B1" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
          </StackPanel></Button>
          <Button Grid.Column="1" x:Name="PrimaryButton" Click="PlayClick" AutomationProperties.Name="Play or stop sound"><StackPanel Orientation="Horizontal"><TextBlock x:Name="PrimaryText" Text="Play Sound" Margin="0,0,6,0"/><Border Style="{StaticResource Keycap}"><TextBlock Text="↵" HorizontalAlignment="Center" FontSize="14"/></Border></StackPanel></Button>
          <Border Grid.Column="2" Background="{StaticResource Hairline}" Width="1" Height="15" Margin="3,0"/>
          <Button Grid.Column="3" Click="ActionsClick" AutomationProperties.Name="Actions"><StackPanel Orientation="Horizontal"><TextBlock Text="Actions" Margin="0,0,6,0"/><Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" HorizontalAlignment="Center"/></Border><Border Style="{StaticResource Keycap}"><TextBlock Text="K" HorizontalAlignment="Center"/></Border></StackPanel></Button>
        </Grid>
      </Border>
      <Border Grid.Row="2" x:Name="ProgressLine" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E8888F" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Border Grid.Row="1" x:Name="Notice" HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="650" Margin="12,0,12,10" Padding="12,7" Style="{StaticResource Sheet}" Visibility="Collapsed"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" TextAlignment="Center"/></Border>
      <Border x:Name="DismissLayer" Grid.RowSpan="3" Background="Transparent" Visibility="Collapsed" MouseLeftButtonDown="DismissClick"/>
      <Border x:Name="MenuPanel" Grid.RowSpan="2" HorizontalAlignment="Right" Width="340" VerticalAlignment="Bottom" MaxHeight="320" Margin="10,0,11,8" Style="{StaticResource Sheet}" Visibility="Collapsed">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="39"/></Grid.RowDefinitions>
          <TextBlock x:Name="MenuHeading" Margin="14,10,14,5" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
          <ListBox x:Name="Commands" Grid.Row="1" Margin="5,0,5,5" MaxHeight="225" PreviewMouseLeftButtonUp="CommandClick" AutomationProperties.Name="Available actions"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Height" Value="32"/><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Keys}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Secondary}" Width="24"/><TextBlock Text="{Binding Title}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <Border Grid.Row="2" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="14,0"><Grid><TextBlock x:Name="MenuHint" Text="Search actions..." Foreground="{StaticResource Muted}" IsHitTestVisible="False"/><TextBox x:Name="MenuSearch" AutomationProperties.Name="Search actions" TextChanged="MenuSearchChanged"/></Grid></Border>
        </Grid>
      </Border>
      <Border x:Name="EditPanel" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="340" Margin="10,0,11,8" Padding="15" Style="{StaticResource Sheet}" Visibility="Collapsed">
        <StackPanel><TextBlock x:Name="EditTitle" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="EditHint" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,10"/><Border x:Name="EditInputBorder" CornerRadius="5" BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="8,6"><TextBox x:Name="EditText" MaxLength="100" AutomationProperties.Name="New sound name"/></Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Cancel" Click="CancelEdit"/><Button x:Name="ConfirmEdit" Background="#21FFFFFF" Padding="12,5" Margin="6,0,0,0" Click="CommitEdit"/></StackPanel></StackPanel>
      </Border>
      <Border x:Name="DropLayer" Grid.RowSpan="3" Margin="5" Background="#F02C2A30" BorderBrush="#D18F94" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="27" Foreground="#F2ACB2" HorizontalAlignment="Center"/><TextBlock Text="Drop sounds to import" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/><TextBlock Text="Your clips stay on this PC." Foreground="{StaticResource Secondary}" HorizontalAlignment="Center"/></StackPanel></Border>
    </Grid>
  </Border>
</Window>
